{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/books/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "build": {
    "env": {
      "BOOKS_BASE_PATH": "/",
      "BOOKS_PUBLIC_ORIGIN": "https://n-e-n.ru"
    }
  }
}
