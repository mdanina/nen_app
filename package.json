{
  "name": "nen-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nen/books dev",
    "dev:books": "pnpm --filter @nen/books dev",
    "catalog:build": "node scripts/build-books-catalog.mjs",
    "collections:import:nen": "node scripts/books/import-nen-collection-books.mjs",
    "collections:build": "node scripts/books/build-nen-collections.mjs",
    "import:openlibrary": "node scripts/openlibrary/import-pilot.mjs",
    "import:openlibrary:fixture": "node scripts/openlibrary/import-pilot.mjs --input data/import/openlibrary/fixtures/pilot-fragment.txt --output data/import/openlibrary/pilot --dump-date 2026-07-01 --limit 1000 --seed 20260721 --fixture",
    "import:universal:fixture": "node scripts/openlibrary/import-universal.mjs --input data/import/openlibrary/fixtures/pilot-fragment.txt --output data/import/staging/openlibrary-pilot --retrieved-at 2026-07-21T00:00:00.000Z --batch-id openlibrary-pilot-20260721",
    "import:openlibrary:large": "node scripts/openlibrary/import-large.mjs",
    "import:openlibrary:large:fixture": "node scripts/openlibrary/import-large.mjs --input data/import/openlibrary/fixtures/pilot-fragment.txt --database data/import/openlibrary/state/catalog.sqlite --output data/import/openlibrary/large-pilot --dump-date 2026-07-01 --retrieved-at 2026-07-21T00:00:00.000Z --batch-id openlibrary-large-pilot-20260721",
    "import:openlibrary:russian-children": "node scripts/openlibrary/import-russian-children.mjs --output data/import/openlibrary/russian-children-staging --seed 20260722",
    "test:openlibrary": "node --test scripts/openlibrary/pipeline.test.mjs scripts/openlibrary/universal-adapter.test.mjs scripts/openlibrary/mass-import.test.mjs scripts/openlibrary/russian-children-import.test.mjs scripts/openlibrary/prepare-app-catalog.test.mjs scripts/openlibrary/prepare-publish-ready.test.mjs scripts/openlibrary/reevaluate-publish-ready.test.mjs packages/import-core/src/import-core.test.mjs",
    "prepare:openlibrary:publish-ready": "node scripts/openlibrary/prepare-publish-ready.mjs",
    "prepare:openlibrary:reevaluate": "node scripts/openlibrary/reevaluate-publish-ready.mjs",
    "import:bnf": "node scripts/bnf/import-bnf.mjs --output data/import/bnf/staging --max-books 3000 --work-target 3300 --sparql-page-size 100 --sru-batch-size 40 --seed 20260722",
    "test:bnf": "node --test scripts/bnf/pipeline.test.mjs",
    "validate:bnf": "node scripts/bnf/validate-bnf.mjs data/import/bnf/staging",
    "build": "pnpm catalog:build && pnpm --filter @nen/books build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "node --test scripts/books/book-recommendation.test.mjs scripts/books/nen-collections.test.mjs && pnpm -r --if-present test"
  },
  "devDependencies": {
    "typescript": "latest"
  }
}
